table 'dev customer_summary'
	lineageTag: 2c97f8d4-ac96-463d-84af-f1b11c2542f6

	/// Customers with at least one delivered, paid order.
	measure 'Purchasing Customers' = COUNTROWS('dev customer_summary')
		formatString: #,##0
		lineageTag: 6633780f-84cc-43ab-89b1-1b864598878f

	/// Share of customers with exactly one delivered order.
	measure 'One-time Customer Share' = DIVIDE(CALCULATE(COUNTROWS('dev customer_summary'), 'dev customer_summary'[order_count] = 1), COUNTROWS('dev customer_summary'))
		formatString: 0.0%
		lineageTag: e3eac846-630e-40aa-8804-7bf5b9f0e57a

	/// Customers who made a second purchase on a different day within 180 days, among customers observed for 180+ days.
	measure 'Repeat Rate 180d' = DIVIDE(CALCULATE(COUNTROWS('dev customer_summary'), 'dev customer_summary'[returned_within_180d] = TRUE(), 'dev customer_summary'[is_observed_180d] = TRUE()), CALCULATE(COUNTROWS('dev customer_summary'), 'dev customer_summary'[is_observed_180d] = TRUE()))
		formatString: 0.00%
		lineageTag: 6326d55e-96f1-4688-a07c-0b344b45ec3b

	/// Median days between first and second purchase day, for repeat customers.
	measure 'Median Days to 2nd Purchase' = MEDIAN('dev customer_summary'[days_to_second_purchase])
		formatString: 0
		lineageTag: 136024bf-36ce-4d3d-b3ed-1f28359856d1

