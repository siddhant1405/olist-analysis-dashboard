table 'dev freight_subsidy_breakeven'
	lineageTag: 917e3696-6b99-4b23-b202-c51a53c11b3e

	/// Freight as a share of item value in the order value band.
	measure 'Band Freight Share' = DIVIDE(SUM('dev freight_subsidy_breakeven'[freight_value]), SUM('dev freight_subsidy_breakeven'[revenue]))
		formatString: 0.0%
		lineageTag: bef5575a-ad91-4950-8ef4-5da74e08066d

	/// A freight subsidy adds profit only below this freight share, if commission is 10%.
	measure 'Break-even at 10% Commission' = MAX('dev freight_subsidy_breakeven'[breakeven_share_at_10pct])
		formatString: 0.0%
		lineageTag: e330aa0b-2779-4ab2-b6ab-4a46d73fef57

	/// A freight subsidy adds profit only below this freight share, if commission is 15%.
	measure 'Break-even at 15% Commission' = MAX('dev freight_subsidy_breakeven'[breakeven_share_at_15pct])
		formatString: 0.0%
		lineageTag: 6a9e208b-12e4-4255-bb7e-0c5266e8a3cb

	/// A freight subsidy adds profit only below this freight share, if commission is 20%.
	measure 'Break-even at 20% Commission' = MAX('dev freight_subsidy_breakeven'[breakeven_share_at_20pct])
		formatString: 0.0%
		lineageTag: dad7c672-3acd-4a2d-8042-8b7af1ce354b

