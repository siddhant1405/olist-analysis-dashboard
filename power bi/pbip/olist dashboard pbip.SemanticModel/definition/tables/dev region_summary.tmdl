table 'dev region_summary'
	lineageTag: e4052353-3614-4b8a-ad9b-8c2d152c23e5

	/// Distinct customers per 100,000 residents (2022 Census).
	measure 'Customers per 100k' = DIVIDE(SUM('dev region_summary'[customers]) * 100000, SUM('dev region_summary'[population_2022]))
		formatString: #,##0.0
		lineageTag: 80747d89-5e58-43fd-bcd6-2774299f5873

	/// Share of Brazil's population.
	measure 'Share of Population' = DIVIDE(SUM('dev region_summary'[population_2022]), CALCULATE(SUM('dev region_summary'[population_2022]), REMOVEFILTERS('dev region_summary')))
		formatString: 0.0%
		lineageTag: 05cc16dd-fb42-4130-80b9-0a04d4c90418

	/// Share of Olist's customers.
	measure 'Share of Customers' = DIVIDE(SUM('dev region_summary'[customers]), CALCULATE(SUM('dev region_summary'[customers]), REMOVEFILTERS('dev region_summary')))
		formatString: 0.0%
		lineageTag: ba6eaf3b-0cb0-409a-9b59-499b8435ce31

	/// Share of Olist's sellers.
	measure 'Share of Sellers' = DIVIDE(SUM('dev region_summary'[seller_count]), CALCULATE(SUM('dev region_summary'[seller_count]), REMOVEFILTERS('dev region_summary')))
		formatString: 0.0%
		lineageTag: bbc18615-96fe-4fa0-9ef5-8ee34860d801

	/// Freight as a share of item value.
	measure 'Region Freight Share' = DIVIDE(SUM('dev region_summary'[freight_value]), SUM('dev region_summary'[revenue]))
		formatString: 0.0%
		lineageTag: 9ac2e6d7-6030-4c28-8b4f-a498b2ac6f8c

	/// Order-weighted late delivery rate.
	measure 'Region Late Rate' = DIVIDE(SUMX('dev region_summary', 'dev region_summary'[late_rate] * 'dev region_summary'[delivered_orders]), SUM('dev region_summary'[delivered_orders]))
		formatString: 0.0%
		lineageTag: ebd1ba04-3e77-4b41-9cc3-a75f18018798

	/// Order-weighted average review score.
	measure 'Region Avg Review' = DIVIDE(SUMX('dev region_summary', 'dev region_summary'[avg_review_score] * 'dev region_summary'[delivered_orders]), SUM('dev region_summary'[delivered_orders]))
		formatString: 0.00
		lineageTag: fb851ef8-41b6-4a54-b12e-f1d6779dfba5

