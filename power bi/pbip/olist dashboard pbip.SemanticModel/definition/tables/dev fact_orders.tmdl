	partition 'dev fact_orders' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost:5434", "olist_dw"),
				    dev_fact_orders = Source{[Schema="dev",Item="fact_orders"]}[Data]
				in
				    dev_fact_orders

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

