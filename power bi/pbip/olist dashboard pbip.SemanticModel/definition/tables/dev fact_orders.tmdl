table 'dev fact_orders'
	lineageTag: 9cdefce9-1050-451f-88c3-9be36dd69cf7

	measure 'Total revenue' = SUM('dev fact_order_items'[price])
		lineageTag: d220fefc-72a2-4706-8745-e44976eaf179

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total orders' = DISTINCTCOUNT('dev fact_orders'[order_id])
		formatString: 0
		lineageTag: e396dd91-e192-4d6a-8e7a-f4a6fc28fb44

	measure 'Avg delivery days' = AVERAGE('dev fact_orders'[delivery_days])
		lineageTag: e9b6c03d-4cc3-4e6f-ab01-ece8c0b265b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Order Value' = SUM('dev fact_orders'[total_payment_value])
		lineageTag: 1c4d3c58-af87-458c-93f5-1a9ca5058fca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Avg_order_value = AVERAGE('dev fact_orders'[total_payment_value])
		lineageTag: 270accbc-5429-459f-9a5c-db1f2775f8c9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Revenue from listed item prices, respecting date, state, and category context.
	measure Revenue =
			VAR _orders = VALUES('dev fact_orders'[order_id])
			RETURN CALCULATE(SUM('dev fact_order_items'[price]), TREATAS(_orders, 'dev fact_order_items'[order_id]))
		formatString: #,##0.00
		lineageTag: 4437c570-1be3-4335-8478-349683e48af9

	/// Distinct orders in the active date, state, and product-category context.
	measure Orders =
			VAR _orders = VALUES('dev fact_orders'[order_id])
			RETURN CALCULATE(DISTINCTCOUNT('dev fact_order_items'[order_id]), TREATAS(_orders, 'dev fact_order_items'[order_id]))
		formatString: #,##0
		lineageTag: c71eba2b-2931-4e9b-aaf7-efcfe15f1fc1

	/// Distinct purchasing customers for the active order and category context.
	measure 'Customer Count' =
			VAR _orders = CALCULATETABLE(VALUES('dev fact_order_items'[order_id]), TREATAS(VALUES('dev fact_orders'[order_id]), 'dev fact_order_items'[order_id]))
			RETURN CALCULATE(DISTINCTCOUNT('dev fact_orders'[customer_unique_id]), TREATAS(_orders, 'dev fact_orders'[order_id]))
		formatString: #,##0
		lineageTag: 312672fa-f81c-4ca0-bb8c-7a340e6b5f7d

	/// Average listed-price revenue per order.
	measure AOV = DIVIDE([Revenue], [Orders])
		formatString: #,##0.00
		lineageTag: e8721754-b9c2-4cef-ab29-6042d420f37b

	/// Orders divided by distinct purchasing customers.
	measure 'Orders per Customer' = DIVIDE([Orders], [Customer Count])
		formatString: #,##0.00
		lineageTag: b091314e-4d71-4445-bab5-62685b0e32fe

	/// Distinct people (customer_unique_id), not order-level customer_id.
	measure 'Unique Customers' = DISTINCTCOUNT('dev fact_orders'[customer_unique_id])
		formatString: #,##0
		lineageTag: db0c653a-d73c-4c3e-b61b-af6646e9964d

	/// Delivered orders inside the analysis window.
	measure 'Delivered Orders' = CALCULATE(COUNTROWS('dev fact_orders'), 'dev fact_orders'[is_delivered] = TRUE(), 'dev fact_orders'[is_in_analysis_window] = TRUE())
		formatString: #,##0
		lineageTag: 39807e4e-5bed-437d-91f4-3b0872ca22f6

	/// Orders delivered after the estimated date, inside the analysis window.
	measure 'Late Orders' = CALCULATE(COUNTROWS('dev fact_orders'), 'dev fact_orders'[is_late] = TRUE(), 'dev fact_orders'[is_in_analysis_window] = TRUE())
		formatString: #,##0
		lineageTag: 25b4d237-94a1-4bf9-bbf5-059bc4948cde

	/// Late orders as a share of delivered orders.
	measure 'Late Delivery Rate' = DIVIDE([Late Orders], [Delivered Orders])
		formatString: 0.0%
		lineageTag: 8f739572-7815-4651-8fa2-1da3804b8b23

	/// Average review score of on-time deliveries.
	measure 'Avg Review (On Time)' = CALCULATE(AVERAGE('dev fact_orders'[review_score]), 'dev fact_orders'[is_late] = FALSE(), 'dev fact_orders'[is_delivered] = TRUE(), 'dev fact_orders'[is_in_analysis_window] = TRUE())
		formatString: 0.00
		lineageTag: 40652260-150b-4792-96a0-6e2afe131ac1

	/// Average review score of late deliveries.
	measure 'Avg Review (Late)' = CALCULATE(AVERAGE('dev fact_orders'[review_score]), 'dev fact_orders'[is_late] = TRUE(), 'dev fact_orders'[is_in_analysis_window] = TRUE())
		formatString: 0.00
		lineageTag: 897437f8-bfec-4297-ad7f-184f2980ad11

	/// Share of 1-2 star reviews on delivered orders that came from late deliveries.
	measure 'Late Share of Bad Reviews' = DIVIDE(CALCULATE(COUNTROWS('dev fact_orders'), 'dev fact_orders'[is_late] = TRUE(), 'dev fact_orders'[review_score] IN {1, 2}, 'dev fact_orders'[is_in_analysis_window] = TRUE()), CALCULATE(COUNTROWS('dev fact_orders'), 'dev fact_orders'[is_delivered] = TRUE(), 'dev fact_orders'[review_score] IN {1, 2}, 'dev fact_orders'[is_in_analysis_window] = TRUE()))
		formatString: 0.0%
		lineageTag: 8fa9f6d2-ce51-4a4f-ac53-4a883895cf70

	/// Average days from purchase to the estimated delivery date.
	measure 'Avg Promised Days' = CALCULATE(AVERAGE('dev fact_orders'[promised_days]), 'dev fact_orders'[is_delivered] = TRUE(), 'dev fact_orders'[is_in_analysis_window] = TRUE())
		formatString: 0.0
		lineageTag: 6bc453e0-0571-458d-8343-598ee28cb07b

	/// Average days from purchase to delivery.
	measure 'Avg Actual Delivery Days' = CALCULATE(AVERAGE('dev fact_orders'[delivery_days]), 'dev fact_orders'[is_delivered] = TRUE(), 'dev fact_orders'[is_in_analysis_window] = TRUE())
		formatString: 0.0
		lineageTag: 639627fc-1aea-446c-8b54-c8fccc453c42

	/// Delivered orders handed to the carrier after the seller's shipping limit.
	measure 'Seller Handoff Late Rate' = DIVIDE(CALCULATE(COUNTROWS('dev fact_orders'), 'dev fact_orders'[is_seller_handoff_late] = TRUE(), 'dev fact_orders'[is_delivered] = TRUE(), 'dev fact_orders'[is_in_analysis_window] = TRUE()), CALCULATE(COUNTROWS('dev fact_orders'), NOT ISBLANK('dev fact_orders'[is_seller_handoff_late]), 'dev fact_orders'[is_delivered] = TRUE(), 'dev fact_orders'[is_in_analysis_window] = TRUE()))
		formatString: 0.0%
		lineageTag: 454a0c62-999a-4ffa-bc3e-e7ad3f991a85

	/// Share of revenue from customers' first purchase day.
	measure 'New Customer Revenue Share' = DIVIDE(CALCULATE([Revenue], 'dev fact_orders'[customer_type] = "New"), [Revenue])
		formatString: 0.0%
		lineageTag: c702b607-e96f-4534-8fc2-b18cd7914d4b

	/// Freight charged as a share of item value, delivered orders in the analysis window.
	measure 'Freight % of Item Value' = CALCULATE(DIVIDE(SUM('dev fact_orders'[freight_value]), SUM('dev fact_orders'[items_value])), 'dev fact_orders'[is_delivered] = TRUE(), 'dev fact_orders'[is_in_analysis_window] = TRUE())
		formatString: 0.0%
		lineageTag: 77cc1e16-4be8-4e39-9ad6-f7103a60c0c0

	/// Average freight charged per delivered order.
	measure 'Avg Freight per Order' = CALCULATE(AVERAGE('dev fact_orders'[freight_value]), 'dev fact_orders'[is_delivered] = TRUE(), 'dev fact_orders'[is_in_analysis_window] = TRUE())
		formatString: #,##0.00
		lineageTag: 90ef3987-19e9-4ab4-8262-eccb0374758c

	/// Share of delivered orders shipped only by sellers in the customer's state.
	measure 'Local Seller Order Share' = DIVIDE(CALCULATE(COUNTROWS('dev fact_orders'), 'dev fact_orders'[seller_origin] = "Same state", 'dev fact_orders'[is_delivered] = TRUE(), 'dev fact_orders'[is_in_analysis_window] = TRUE()), [Delivered Orders])
		formatString: 0.0%
		lineageTag: 29ab9381-e3f8-4146-9398-279c3bdc717c

	/// Share of reviewed orders scoring 1 or 2 stars, any delivery status.
	measure 'Bad Review Rate' = DIVIDE(CALCULATE(COUNTROWS('dev fact_orders'), 'dev fact_orders'[review_score] IN {1, 2}, 'dev fact_orders'[is_in_analysis_window] = TRUE()), CALCULATE(COUNTROWS('dev fact_orders'), NOT ISBLANK('dev fact_orders'[review_score]), 'dev fact_orders'[is_in_analysis_window] = TRUE()))
		formatString: 0.0%
		lineageTag: 6da058f1-372d-44d3-b51e-84be7a3c281a

	/// Share of all 1-2 star reviews falling in the current experience group.
	measure 'Share of Bad Reviews' = DIVIDE(CALCULATE(COUNTROWS('dev fact_orders'), 'dev fact_orders'[review_score] IN {1, 2}, 'dev fact_orders'[is_in_analysis_window] = TRUE()), CALCULATE(CALCULATE(COUNTROWS('dev fact_orders'), 'dev fact_orders'[review_score] IN {1, 2}, 'dev fact_orders'[is_in_analysis_window] = TRUE()), REMOVEFILTERS('dev fact_orders'[experience_group], 'dev fact_orders'[experience_group_sort])))
		formatString: 0.0%
		lineageTag: a093e136-dd6b-481c-b5a6-35de5458c572

