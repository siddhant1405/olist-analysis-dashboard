table 'dev customer_rfm'
	lineageTag: 0ab390ba-6002-43da-a3c7-1e5538209f21

	measure 'Eligible Customer Count' = DISTINCTCOUNT('dev customer_rfm'[customer_unique_id])
		formatString: #,##0
		lineageTag: 6d3a5650-851e-41d2-b10b-8b3841bd2079

	measure 'RFM Customer Share' = DIVIDE([Eligible Customer Count], CALCULATE([Eligible Customer Count], REMOVEFILTERS('dev customer_rfm'[rfm_segment])))
		formatString: 0.0%
		lineageTag: c415405d-fcbe-45b2-91f4-f5a9b4dad034

	measure 'RFM Monetary Contribution' = SUM('dev customer_rfm'[monetary])
		formatString: #,##0.00
		lineageTag: 7a2974e6-d3df-4f25-93c0-0f98a04c6414

