table 'dev customer_rfm'
	lineageTag: e6c01646-4ca9-4c79-9054-2f703888359e

	/// Customers included in the segmentation.
	measure 'Eligible Customer Count' = DISTINCTCOUNT('dev customer_rfm'[customer_unique_id])
		formatString: #,##0
		lineageTag: 24d0cc26-c4f5-4da8-83ec-85dbd1e5ece1

	/// Share of all segmented customers.
	measure 'RFM Customer Share' = DIVIDE([Eligible Customer Count], CALCULATE([Eligible Customer Count], REMOVEFILTERS('dev customer_rfm')))
		formatString: 0.0%
		lineageTag: ec5a0a33-1a75-430c-85b6-472df165aff0

	/// Lifetime payment value of the customers in context.
	measure 'RFM Monetary Contribution' = SUM('dev customer_rfm'[monetary])
		formatString: #,##0.00
		lineageTag: ec1e4f69-97aa-4277-a1f8-f1d2bbe05626

	/// Share of all customer lifetime payment value.
	measure 'RFM Revenue Share' = DIVIDE([RFM Monetary Contribution], CALCULATE([RFM Monetary Contribution], REMOVEFILTERS('dev customer_rfm')))
		formatString: 0.0%
		lineageTag: b927b875-8d0d-4b76-a57e-f64d4d13f65f

	/// Average lifetime payment value per customer.
	measure 'Avg Customer Value' = AVERAGE('dev customer_rfm'[monetary])
		formatString: #,##0.00
		lineageTag: cab03d18-3eae-4084-b7a2-1c61984f075e

