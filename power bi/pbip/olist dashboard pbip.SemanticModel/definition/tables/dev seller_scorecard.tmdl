table 'dev seller_scorecard'
	lineageTag: b3330e93-c54a-450f-bde9-fee571032f12

	/// Sellers with delivered orders in the analysis window.
	measure 'Scored Sellers' = COUNTROWS('dev seller_scorecard')
		formatString: #,##0
		lineageTag: 4897de60-ae6f-4673-841c-6287e793004a

	/// Sellers with 30+ orders and a late rate at least twice the platform rate.
	measure 'High-Risk Sellers' = CALCULATE(COUNTROWS('dev seller_scorecard'), 'dev seller_scorecard'[performance_tier] = "High risk")
		formatString: #,##0
		lineageTag: 639ecf06-6c3e-4e69-b0eb-bde78d2a430d

	/// Late seller-orders divided by delivered seller-orders.
	measure 'Seller Late Rate' = DIVIDE(SUM('dev seller_scorecard'[late_orders]), SUM('dev seller_scorecard'[delivered_orders]))
		formatString: 0.0%
		lineageTag: 60136e9b-d533-47f3-8297-91d92bd28bbc

	/// Share of all delivered seller-orders.
	measure 'Share of Seller Orders' = DIVIDE(SUM('dev seller_scorecard'[delivered_orders]), CALCULATE(SUM('dev seller_scorecard'[delivered_orders]), REMOVEFILTERS('dev seller_scorecard')))
		formatString: 0.0%
		lineageTag: c39ac8a1-6c18-4388-a0e2-f7b7549edc72

	/// Share of all late seller-orders.
	measure 'Share of Late Orders' = DIVIDE(SUM('dev seller_scorecard'[late_orders]), CALCULATE(SUM('dev seller_scorecard'[late_orders]), REMOVEFILTERS('dev seller_scorecard')))
		formatString: 0.0%
		lineageTag: 8fd6b17b-188e-4424-a6f4-dc01e3d329d5

	/// Order-weighted average review score.
	measure 'Seller Avg Review' = DIVIDE(SUMX('dev seller_scorecard', 'dev seller_scorecard'[avg_review_score] * 'dev seller_scorecard'[delivered_orders]), SUM('dev seller_scorecard'[delivered_orders]))
		formatString: 0.00
		lineageTag: 955d7cb5-7c59-4a19-9fc9-9eaa2f8ee92f

