	partition 'dev fact_orders' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost", "olist_dw"),
				    dev_fact_orders = Source{[Schema="dev",Item="fact_orders"]}[Data],
				    #"Added Conditional Column" = Table.AddColumn(dev_fact_orders, "Delivery Bucket", each if [delivery_days_vs_estimated] > 0 then "Early" else if [delivery_days_vs_estimated] = 0 then "On Time" else "Late")
				in
				    #"Added Conditional Column"

