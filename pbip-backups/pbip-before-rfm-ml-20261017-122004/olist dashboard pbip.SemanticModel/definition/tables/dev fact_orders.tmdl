table 'dev fact_orders'
	lineageTag: 9cdefce9-1050-451f-88c3-9be36dd69cf7

	measure 'Total revenue' = SUM('dev fact_order_items'[price])
		lineageTag: d220fefc-72a2-4706-8745-e44976eaf179

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total orders' = DISTINCTCOUNT('dev fact_orders'[order_id])
		formatString: 0
		lineageTag: e396dd91-e192-4d6a-8e7a-f4a6fc28fb44

	measure 'Avg delivery days' = AVERAGE('dev fact_orders'[delivery_days])
		lineageTag: e9b6c03d-4cc3-4e6f-ab01-ece8c0b265b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Order Value' = SUM('dev fact_orders'[total_payment_value])
		lineageTag: 1c4d3c58-af87-458c-93f5-1a9ca5058fca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Avg_order_value = AVERAGE('dev fact_orders'[total_payment_value])
		lineageTag: 270accbc-5429-459f-9a5c-db1f2775f8c9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Revenue from listed item prices, respecting date, state, and category context.
	measure Revenue =
			VAR _orders = VALUES('dev fact_orders'[order_id])
			RETURN CALCULATE(SUM('dev fact_order_items'[price]), TREATAS(_orders, 'dev fact_order_items'[order_id]))
		formatString: #,##0.00
		lineageTag: 4437c570-1be3-4335-8478-349683e48af9

	/// Distinct orders in the active date, state, and product-category context.
	measure Orders =
			VAR _orders = VALUES('dev fact_orders'[order_id])
			RETURN CALCULATE(DISTINCTCOUNT('dev fact_order_items'[order_id]), TREATAS(_orders, 'dev fact_order_items'[order_id]))
		formatString: #,##0
		lineageTag: c71eba2b-2931-4e9b-aaf7-efcfe15f1fc1

	/// Distinct purchasing customers for the active order and category context.
	measure 'Customer Count' =
			VAR _orders = CALCULATETABLE(VALUES('dev fact_order_items'[order_id]), TREATAS(VALUES('dev fact_orders'[order_id]), 'dev fact_order_items'[order_id]))
			RETURN CALCULATE(DISTINCTCOUNT('dev fact_orders'[customer_id]), TREATAS(_orders, 'dev fact_orders'[order_id]))
		formatString: #,##0
		lineageTag: 312672fa-f81c-4ca0-bb8c-7a340e6b5f7d

	/// Average listed-price revenue per order.
	measure AOV = DIVIDE([Revenue], [Orders])
		formatString: #,##0.00
		lineageTag: e8721754-b9c2-4cef-ab29-6042d420f37b

	/// Orders divided by distinct purchasing customers.
	measure 'Orders per Customer' = DIVIDE([Orders], [Customer Count])
		formatString: #,##0.00
		lineageTag: b091314e-4d71-4445-bab5-62685b0e32fe

	/// Scenario baseline; this is historical listed-price revenue.
	measure 'Baseline Revenue' = [Revenue]
		formatString: #,##0.00
		lineageTag: 9401237a-7f8b-4d69-adf7-fb41a854d020

	/// Assumed COGS rate for scenario analysis; this is not an Olist historical field.
	measure 'COGS Assumption' = 0.65
		formatString: 0%
		lineageTag: 4562e903-5263-4a40-989f-33788589221d

	/// Selected what-if discount rate; defaults to the lowest scenario when no scenario is selected.
	measure 'Selected Discount Rate' = SELECTEDVALUE('Pricing Scenarios'[Discount Rate], 0.05)
		formatString: 0%
		lineageTag: ff976caa-ffff-4cb2-bbc4-4358d9cc21da

	/// Assumed order-volume response equal to 1.5 times the selected discount rate.
	measure 'Volume Uplift Assumption' = [Selected Discount Rate] * 1.5
		formatString: 0%
		lineageTag: 94659676-7af0-4f96-b4fa-2c45e079d466

	/// Discounted listed-price revenue after the assumed volume uplift.
	measure 'Simulated Revenue' = [Baseline Revenue] * (1 - [Selected Discount Rate]) * (1 + [Volume Uplift Assumption])
		formatString: #,##0.00
		lineageTag: 61bf745b-86a8-469e-8ff6-6239f156e6c2

	/// Estimated COGS after the assumed change in order volume; not a historical Olist cost.
	measure 'Estimated COGS' = [Baseline Revenue] * (1 + [Volume Uplift Assumption]) * [COGS Assumption]
		formatString: #,##0.00
		lineageTag: c008ee82-ce1f-4e2b-aa20-cff0a3c58ec1

	/// Scenario profit after simulated discount, volume, and estimated COGS assumptions.
	measure 'Simulated Profit' = [Simulated Revenue] - [Estimated COGS]
		formatString: #,##0.00
		lineageTag: a9e9920a-9a22-4acc-8f03-da5e70e9b22a

	/// Scenario profit as a share of simulated revenue.
	measure 'Simulated Profit Margin' = DIVIDE([Simulated Profit], [Simulated Revenue])
		formatString: 0.0%
		lineageTag: 6390e8e5-0220-432e-a332-ac4513053f55

	/// Incremental volume required to preserve baseline profit; blank when a discounted unit has no positive contribution margin.
	measure 'Break-even Volume Uplift' =
			VAR _contribution = (1 - [Selected Discount Rate]) - [COGS Assumption]
			RETURN IF(_contribution <= 0, BLANK(), DIVIDE(1 - [COGS Assumption], _contribution) - 1)
		formatString: 0.0%
		lineageTag: 1b6d4349-4f66-4f5c-a8ed-d13a3e4d7c23

